# Compose (nombre del proyecto y prefijo de contenedores: ${CLIENT_KEY}-postgres, ${CLIENT_KEY}-nutriapp)
CLIENT_KEY=nutriapp
# Puerto en el host para la app (solo si 3000 está ocupado por otro servicio)
# APP_PORT=3001

# Base de datos Postgres (obligatorio)
# Si usas docker-compose, el compose construye DATABASE_URL desde POSTGRES_* y el host del servicio postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/NutriApp

# Postgres (usado por docker-compose: imagen pgvector/pgvector:pg14, servicio "postgres")
POSTGRES_USERNAME=nutriapp_admin
POSTGRES_PASSWORD=cambia-por-una-contraseña-segura
POSTGRES_DATABASE=nutriapp
# Puerto en el host para conectar con PgAdmin u otro cliente (ej. 5433 si el 5432 ya está usado)
# POSTGRES_EXTERNAL_PORT=5432

# NextAuth (obligatorio en producción)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-un-secreto-largo-y-aleatorio

# Superadmin: login con este email y contraseña (no requiere verificación de email)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=password123

# Email (verificación y usuarios creados por admin)
# Opción 1: Resend (recomendado, una API key)
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=NutriApp <noreply@tudominio.com>

# Opción 2: SMTP (sin Resend)
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
