# Base de datos Postgres (obligatorio)
# Si usas docker-compose, el compose construye DATABASE_URL desde POSTGRES_* y el host postgres-nutriapp
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/NutriApp

# Postgres (usado por docker-compose para el servicio postgres-nutriapp y para DATABASE_URL)
POSTGRES_USER=nutriapp_admin
POSTGRES_PASSWORD=cambia-por-una-contraseña-segura
POSTGRES_DATABASE=nutriapp

# NextAuth (obligatorio en producción)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-un-secreto-largo-y-aleatorio

# Superadmin: login con este email y contraseña (no requiere verificación de email)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=password123

# Email (verificación y usuarios creados por admin)
# Opción 1: Resend (recomendado, una API key)
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=NutriApp <noreply@tudominio.com>

# Opción 2: SMTP (sin Resend)
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
